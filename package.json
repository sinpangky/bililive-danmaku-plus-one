{
  "name": "bililive-danmaku-plus-one",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "Bilibili Live danmaku +1, copy, replies, side-chat actions, fullscreen sending, and local favorites",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "danmaku",
    "browser-extension",
    "bilibili-live"
  ],
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "run-s build:popup build:background build:shared build:content",
    "build:popup": "vite build --mode popup",
    "build:background": "vite build --mode background",
    "build:shared": "vite build --mode shared",
    "build:content": "vite build --mode content",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "node tests/run-browser-e2e.cjs",
    "test:regression": "node --test tests/reply.test.mjs tests/bilibili-dom-config.test.mjs tests/browser-e2e-runner.test.cjs tests/content-media-safety.test.cjs tests/emoji-fallback.test.mjs tests/favorites.test.mjs tests/package-entry.test.cjs",
    "test": "run-s build-only test:unit test:regression",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:check": "run-s \"lint:check:*\"",
    "lint:check:oxlint": "oxlint .",
    "lint:check:eslint": "eslint .",
    "format": "prettier --write --experimental-cli src/",
    "validate:build": "node --check build/extension/background/service-worker.js && node --check build/extension/src/content.js && node --check build/extension/src/shared.js",
    "check": "run-s type-check lint:check build-only validate:build test:coverage test:regression",
    "package": "node scripts/sync-version.cjs && npm run check && node scripts/package.cjs"
  },
  "dependencies": {
    "vue": "^3.5.40"
  },
  "overrides": {
    "minimatch@9.0.9": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "nanoid": "3.3.17",
    "postcss": "8.5.23"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/chrome": "^0.2.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-vue": "~10.9.2",
    "fflate": "^0.8.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.73.0",
    "prettier": "3.9.5",
    "sass": "^1.102.0",
    "sass-embedded": "^1.100.0",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  }
}
