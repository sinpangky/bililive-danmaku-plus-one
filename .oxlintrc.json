{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "vue", "vitest"],
  "env": {
    "browser": true,
    "webextensions": true
  },
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "build/**",
    "dist/**",
    "coverage/**",
    ".tmp/**"
  ]
}
