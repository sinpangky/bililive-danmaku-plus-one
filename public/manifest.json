{
  "manifest_version": 3,
  "name": "bililive-danmaku-plus-one",
  "description": "B站直播弹幕 +1、回复、全屏发送与本地收藏工具。",
  "default_locale": "zh_CN",
  "version": "0.0.1",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://live.bilibili.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "bililive-danmaku-plus-one 设置",
    "default_popup": "index.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://live.bilibili.com/*"
      ],
      "js": [
        "src/shared.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
